---
import Layout from '../layouts/Layout.astro';
import { content, projects, type Lang } from '../data/content';
const {lang='es'}=Astro.props as {lang?:Lang};
const t=content[lang];
const projectPath=(slug:string)=>lang==='es'?`/proyectos/${slug}/`:`/en/projects/${slug}/`;
---
<Layout lang={lang} title={lang==='es'?'ROK Atelier — Arquitectura que se siente':'ROK Atelier — Architecture to be felt'} alternate={lang==='es'?'/en/':'/'}>
  <section class="hero" aria-labelledby="hero-title">
    <img class="hero-image" src="/images/hero-concept.webp" srcset="/images/hero-concept-mobile.webp 900w, /images/hero-concept.webp 2200w" sizes="100vw" alt={projects[0][lang].imageAlt} width="2200" height="1238" fetchpriority="high" />
    <div class="hero-shade"></div><div class="hero-side-note">{t.tagline}</div>
    <div class="hero-content"><p class="eyebrow hero-eyebrow">{t.heroLabel}</p><h1 id="hero-title"><span>{t.heroTitle[0]}</span><em>{t.heroTitle[1]}</em></h1><a class="hero-link" href="#espacios">{t.explore}<span class="circle-plus" aria-hidden="true"><span class="plus"></span></span></a></div>
    <div class="hero-bottom"><p>{t.heroFoot}</p><span class="hero-caption">{t.heroCaption}</span><a href="#esencia" class="scroll-prompt"><span></span>{t.scroll}</a></div>
  </section>
  <section class="essence section-pad" id="esencia">
    <div class="section-kicker reveal"><span class="small-rule"></span><p class="eyebrow">{t.introLabel}</p></div>
    <div class="essence-main"><h2 class="reveal">{t.introTitle[0]}<br/><em>{t.introTitle[1]}</em></h2><div class="essence-bottom reveal"><span class="architectural-mark" aria-hidden="true"><i></i><i></i><i></i></span><div><p>{t.introBody}</p><a class="text-link" href="#atelier">{t.introLink}<span class="plus" aria-hidden="true"></span></a></div></div></div>
  </section>
  <section class="projects-section section-pad" id="espacios">
    <div class="projects-heading reveal"><div><p class="eyebrow">{t.projectsLabel}</p><h2>{t.projectsTitle}</h2></div><p>{t.projectsDesc}</p></div>
    <div class="projects-toolbar reveal"><div class="project-filters" role="group" aria-label={lang==='es'?'Filtrar espacios':'Filter spaces'}>{t.filters.map((f,i)=><button data-filter={['all','architecture','interiors'][i]} aria-pressed={i===0}>{f}</button>)}</div><span class="collection-note">{t.reference}</span></div>
    <div class="project-grid">
      {projects.map((p,i)=><article class:list={['project-card','reveal',`project-${i}`]} data-category={p.category}><a href={projectPath(p.slug)} class="project-image-link" aria-label={`${t.openProject} ${p[lang].title}`}><div class="project-image"><img src={p.image} alt={p[lang].imageAlt} loading="lazy" width="1600" height="1100"/><span class="project-hover">{t.openProject}<span class="plus" aria-hidden="true"></span></span><span class="project-corner" aria-hidden="true"></span></div></a><div class="project-caption"><div><a href={projectPath(p.slug)}><h3>{p[lang].title}</h3></a><p>{p[lang].subtitle}</p></div><span>{p[lang].category}</span></div></article>)}
    </div>
    <p class="reference-note">{t.conceptNotice}</p>
  </section>
  <section class="atelier-section" id="atelier">
    <div class="atelier-image"><img src="/images/atelier-concept.webp" alt={projects[1][lang].imageAlt} loading="lazy" width="1200" height="1500"/><span class="image-label">ROK — {lang==='es'?'EL ESPACIO COMO EXPERIENCIA':'SPACE AS AN EXPERIENCE'}</span></div>
    <div class="atelier-content"><p class="eyebrow reveal">{t.studioLabel}</p><h2 class="reveal">{t.studioTitle[0]}<br/><em>{t.studioTitle[1]}</em></h2><p class="atelier-copy reveal">{t.studioBody}</p><div class="atelier-signature reveal"><span class="signature-line"></span><p>{t.studioNote}</p></div></div>
  </section>
  <section class="perspective-section section-pad" id="mirada">
    <div class="perspective-top reveal"><p class="eyebrow">{lang==='es'?'UNA MIRADA, TRES ESENCIAS':'ONE PERSPECTIVE, THREE ESSENCES'}</p><span class="perspective-note">{lang==='es'?'Lo que hace sentir un espacio.':'What makes a space feel.'}</span></div>
    <div class="perspective-tabs reveal" role="tablist" aria-label={lang==='es'?'Esencias del espacio':'Essences of space'}>{t.philosophy.map((word,i)=><button role="tab" id={`perspective-tab-${i}`} aria-controls={`perspective-panel-${i}`} aria-selected={i===0} tabindex={i===0?0:-1} data-perspective={i}>{word}<span aria-hidden="true">.</span></button>)}</div>
    <div class="perspective-bottom reveal"><div class="material-swatch" aria-hidden="true"><span class="swatch-active"></span><span></span><span></span></div><div>{t.philosophyCopy.map((copy,i)=><p id={`perspective-panel-${i}`} role="tabpanel" aria-labelledby={`perspective-tab-${i}`} hidden={i!==0}>{copy}</p>)}</div><span class="line-symbol" aria-hidden="true"></span></div>
  </section>
  <section class="process-section section-pad">
    <div class="process-intro reveal"><p class="eyebrow">{t.processLabel}</p><h2>{t.processTitle[0]}<br/><em>{t.processTitle[1]}</em></h2><p>{t.processBody}</p></div><div class="process-accordion reveal">{t.steps.map((step,i)=><details name="process" open={i===0}><summary>{step.title}<span class="plus" aria-hidden="true"></span></summary><p>{step.text}</p></details>)}</div>
  </section>
  <section class="contact-section section-pad" id="contacto">
    <div class="contact-grain" aria-hidden="true"></div><div class="contact-top reveal"><p class="eyebrow">{t.contactLabel}</p><span class="contact-cross" aria-hidden="true"></span></div><h2 class="reveal">{t.contactTitle[0]}<br/><em>{t.contactTitle[1]}</em></h2><div class="contact-bottom reveal"><p>{t.contactBody}</p><button class="contact-button" data-open-brief>{t.contactAction}<span class="circle-plus" aria-hidden="true"><span class="plus"></span></span></button></div>
  </section>
  <script>
    const filters=document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    filters.forEach(button=>button.addEventListener('click',()=>{filters.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));const value=button.dataset.filter;document.querySelector('.project-grid')?.classList.toggle('is-filtered',value!=='all');document.querySelectorAll<HTMLElement>('.project-card').forEach(card=>{card.hidden=value!=='all'&&card.dataset.category!==value;if(!card.hidden)card.classList.add('is-visible');});}));
    const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-perspective]'));
    const activate=(button:HTMLButtonElement)=>{tabs.forEach((tab,i)=>{const selected=tab===button;tab.setAttribute('aria-selected',String(selected));tab.tabIndex=selected?0:-1;const panel=document.getElementById(`perspective-panel-${i}`);if(panel)panel.hidden=!selected;});document.querySelector('.material-swatch')?.setAttribute('data-active',button.dataset.perspective||'0');};
    tabs.forEach((button,i)=>{button.addEventListener('click',()=>activate(button));button.addEventListener('keydown',e=>{let next=i;if(e.key==='ArrowRight')next=(i+1)%tabs.length;else if(e.key==='ArrowLeft')next=(i-1+tabs.length)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();tabs[next].focus();activate(tabs[next]);});});
  </script>
</Layout>
