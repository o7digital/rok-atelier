---
import { clientProjects } from '../data/client-projects';
import type { Lang } from '../data/content';
const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
const href = (slug: string) => es ? `/proyectos/${slug}/` : `/en/projects/${slug}/`;
---
<section class="selected-work section-pad" id="espacios" aria-labelledby="selected-work-title">
  <div class="selected-work-heading reveal">
    <div><p class="eyebrow">{es ? 'PROYECTOS SELECCIONADOS · ROK ATELIER' : 'SELECTED PROJECTS · ROK ATELIER'}</p><h2 id="selected-work-title">{es ? 'Espacios con' : 'Spaces with'}<br/><em>{es ? 'identidad propia.' : 'an identity of their own.'}</em></h2></div>
    <p>{es ? 'De la Ciudad de México a Acapulco. Una selección del trabajo del atelier, donde cada espacio encuentra su propio carácter.' : 'From Mexico City to Acapulco. A selection of the atelier’s work, where every space finds its own character.'}</p>
  </div>
  <div class="selected-work-grid">
    {clientProjects.map((project, i) => <article class:list={['selected-work-card', 'reveal', {'selected-work-feature': i === 0}]}>
      <a class="selected-work-image" href={href(project.slug)} aria-label={`${es ? 'Descubrir' : 'Discover'} ${project[lang].cardTitle}`}>
        <img src={project.image} alt={project[lang].imageAlt} width={i === 2 ? 1200 : i === 0 ? 1440 : 960} height={i === 2 ? 900 : i === 0 ? 1920 : 1280} loading="lazy" />
        <span class="project-corner" aria-hidden="true"></span>
        <span class="selected-work-discover"><span>{es ? 'Descubrir el proyecto' : 'Discover the project'}</span><span class="circle-plus" aria-hidden="true"><span class="plus"></span></span></span>
      </a>
      <div class="selected-work-caption"><div><p class="eyebrow">{project[lang].values[0]} · {project[lang].values[1]}</p><a href={href(project.slug)}><h3>{project[lang].cardTitle}</h3></a><p>{project[lang].subtitle}</p></div></div>
    </article>)}
  </div>
  <div class="selected-work-bottom reveal"><p>{es ? 'Una muestra del universo ROK.' : 'A glimpse into the world of ROK.'}</p><a class="text-link" href="https://www.instagram.com/rok.atelier/" target="_blank" rel="noopener noreferrer">{es ? 'Más del atelier en Instagram' : 'More from the atelier on Instagram'}<span class="plus" aria-hidden="true"></span></a></div>
</section>
