---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import { content, type Lang } from '../data/content';
interface Props { lang?: Lang; title?: string; description?: string; alternate?: string; }
const {lang = 'es', title = 'ROK Atelier — Arquitectura que se siente', description = 'Una exploración de arquitectura, luz y materia. Propuesta de experiencia digital para ROK Atelier.', alternate} = Astro.props;
const t = content[lang];
const home = lang === 'es' ? '/' : '/en/';
const links = ['espacios','atelier','mirada','contacto'];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#20241f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/images/hero-concept.webp', Astro.site)} />
    <meta property="og:url" content={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/italiana-400.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-400.ttf" as="font" type="font/ttf" crossorigin />
    <title>{title}</title>
  </head>
  <body data-lang={lang}>
    <a class="skip-link" href="#main">{lang==='es'?'Ir al contenido':'Skip to content'}</a>
    <header class="site-header" id="site-header">
      <a class="brand" href={home} aria-label="ROK Atelier — Inicio"><Wordmark /></a>
      <nav class="desktop-nav" aria-label={lang==='es'?'Navegación principal':'Main navigation'}>
        {t.nav.map((name,i) => <a href={`${home}#${links[i]}`} class:list={{'nav-contact':i===3}}>{name}</a>)}
      </nav>
      <div class="header-end">
        <div class="language-switch" aria-label={lang==='es'?'Idioma':'Language'}><a href={lang==='es'?(Astro.url.pathname.startsWith('/404')?'/':Astro.url.pathname):alternate||'/'} lang="es" aria-current={lang==='es'?'page':undefined}>ES</a><span>/</span><a href={lang==='en'?Astro.url.pathname:alternate||'/en/'} lang="en" aria-current={lang==='en'?'page':undefined}>EN</a></div>
        <button class="menu-toggle" aria-controls="mobile-nav" aria-expanded="false" aria-label={t.menu}><span></span><span></span></button>
      </div>
    </header>
    <nav id="mobile-nav" class="mobile-nav" aria-label={lang==='es'?'Navegación móvil':'Mobile navigation'} hidden inert>
      {t.nav.map((name,i) => <a href={`${home}#${links[i]}`}>{name}</a>)}
      <a class="mobile-instagram" href="https://www.instagram.com/rok.atelier/" target="_blank" rel="noopener noreferrer">Instagram · @rok.atelier</a>
    </nav>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-top"><a href={home} aria-label="ROK Atelier — Inicio"><Wordmark large /></a><div class="footer-right"><p>{t.footerTag}</p><a href="https://www.instagram.com/rok.atelier/" target="_blank" rel="noopener noreferrer">Instagram</a><a href={`${home}#contacto`}>{t.nav[3]}</a></div></div>
      <div class="footer-bottom"><p>{t.footerNote}</p><span>© {new Date().getFullYear()} · ROK ATELIER</span><a href="https://o7digitalgroup.com" target="_blank" rel="noopener noreferrer">o7 Digital</a></div>
    </footer>
    <dialog class="brief-dialog" id="brief-dialog" aria-labelledby="brief-title">
      <button class="dialog-close" aria-label={t.close}><span></span><span></span></button>
      <div class="brief-form-view">
        <span class="eyebrow">ROK ATELIER</span><h2 id="brief-title">{t.formTitle}</h2><p>{t.formDesc}</p>
        <form id="brief-form">
          <div class="form-row"><label>{t.nameLabel}<input name="name" autocomplete="name" required maxlength="100" /></label><label>{t.locationLabel}<input name="location" autocomplete="address-level2" required maxlength="160" /></label></div>
          <fieldset><legend>{t.typeLabel}</legend><div class="type-options">{t.types.map((type,i)=><label><input type="radio" name="type" value={type} checked={i===0} /><span>{type}</span></label>)}</div></fieldset>
          <label>{t.messageLabel}<textarea name="message" rows="3" maxlength="1200" placeholder={t.messagePlaceholder}></textarea></label>
          <button class="solid-button" type="submit">{t.prepare}<span class="plus" aria-hidden="true"></span></button>
        </form>
      </div>
      <div class="brief-result" hidden><span class="eyebrow">ROK ATELIER</span><h2 tabindex="-1">{t.summaryTitle}</h2><p>{t.summaryDesc}</p><textarea id="brief-text" readonly rows="8" aria-label={lang==='es'?'Mensaje preparado':'Prepared message'}></textarea><div class="result-buttons"><button class="solid-button" id="copy-brief" data-copy={t.copy} data-copied={t.copied} data-error={t.copyError}>{t.copy}</button><a class="outline-button" href="https://www.instagram.com/rok.atelier/" target="_blank" rel="noopener noreferrer">{t.send}</a></div><p class="copy-status" role="status"></p><button class="text-link edit-brief">{t.edit}</button></div>
    </dialog>
    <script>
      const header=document.querySelector<HTMLElement>('.site-header');
      const updateHeader=()=>header?.classList.toggle('scrolled',window.scrollY>35);
      window.addEventListener('scroll',updateHeader,{passive:true});updateHeader();
      const menuButton=document.querySelector<HTMLButtonElement>('.menu-toggle');
      const menu=document.querySelector<HTMLElement>('.mobile-nav');
      const closeMenu=()=>{menuButton?.setAttribute('aria-expanded','false');if(menu){menu.hidden=true;menu.inert=true;}document.body.classList.remove('menu-open');};
      menuButton?.addEventListener('click',()=>{const opening=menuButton.getAttribute('aria-expanded')!=='true';menuButton.setAttribute('aria-expanded',String(opening));if(menu){menu.hidden=!opening;menu.inert=!opening;}document.body.classList.toggle('menu-open',opening);if(opening)menu?.querySelector('a')?.focus();});
      menu?.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));
      document.addEventListener('keydown',(e)=>{if(e.key==='Escape'&&menuButton?.getAttribute('aria-expanded')==='true'){closeMenu();menuButton.focus();}if(e.key==='Tab'&&menuButton?.getAttribute('aria-expanded')==='true'){const a=menu?.querySelectorAll<HTMLAnchorElement>('a');if(!a?.length)return;const last=a[a.length-1];if(e.shiftKey&&document.activeElement===menuButton){e.preventDefault();last.focus();}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();menuButton.focus();}}});
      const media=window.matchMedia('(min-width: 901px)');media.addEventListener('change',e=>{if(e.matches)closeMenu();});
      if('IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');observer.unobserve(entry.target);}}),{threshold:0.08});document.querySelectorAll('.reveal').forEach(el=>{el.classList.add('will-reveal');observer.observe(el);});}
      const dialog=document.querySelector<HTMLDialogElement>('#brief-dialog');
      document.querySelectorAll('[data-open-brief]').forEach(b=>b.addEventListener('click',()=>{dialog?.showModal();document.body.classList.add('dialog-open');}));
      document.querySelector('.dialog-close')?.addEventListener('click',()=>dialog?.close());
      dialog?.addEventListener('close',()=>document.body.classList.remove('dialog-open'));
      dialog?.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close();}});
      const form=document.querySelector<HTMLFormElement>('#brief-form');const formView=document.querySelector<HTMLElement>('.brief-form-view');const result=document.querySelector<HTMLElement>('.brief-result');const output=document.querySelector<HTMLTextAreaElement>('#brief-text');
      form?.addEventListener('submit',e=>{e.preventDefault();const data=new FormData(form);const en=document.body.dataset.lang==='en';const text=en?`Hello ROK Atelier, my name is ${data.get('name')}.\n\nI would like to discuss: ${data.get('type')}.\nLocation: ${data.get('location')}.\n\n${data.get('message')||''}\n\nI would love to start a conversation about my project.`:`Hola ROK Atelier, soy ${data.get('name')}.\n\nMe gustaría conversar sobre: ${data.get('type')}.\nUbicación: ${data.get('location')}.\n\n${data.get('message')||''}\n\nMe encantaría platicar sobre mi proyecto.`;if(output)output.value=text;if(formView)formView.hidden=true;if(result){result.hidden=false;result.querySelector<HTMLElement>('h2')?.focus();}});
      document.querySelector('.edit-brief')?.addEventListener('click',()=>{if(formView)formView.hidden=false;if(result)result.hidden=true;form?.querySelector('input')?.focus();});
      document.querySelector<HTMLButtonElement>('#copy-brief')?.addEventListener('click',async e=>{const button=e.currentTarget as HTMLButtonElement;const status=document.querySelector('.copy-status');try{await navigator.clipboard.writeText(output?.value||'');if(status)status.textContent=button.dataset.copied||'';}catch{output?.focus();output?.select();if(status)status.textContent=button.dataset.error||'';}});
    </script>
  </body>
</html>
